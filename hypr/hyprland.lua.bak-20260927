-- https://wiki.hypr.land/Configuring/
-- Migrated from hyprland.conf (hyprlang deprecated since Hyprland 0.55).

-- You can split this configuration into multiple files.
-- Host-specific overrides are loaded through a stable shim:
--   ~/.config/hypr/hyprland-local-current.lua
-- The shim should require one tracked profile (desktop/laptop/host).
require("hyprland-local-current")


------------------
---- MONITORS ----
------------------

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- Host-specific monitor layout lives in hyprland-local-<host>.lua
-- hl.layer_rule({ match = { namespace = "hyprpicker" }, no_anim = true })
-- hl.layer_rule({ match = { namespace = "selection" },  no_anim = true })

---------------------
---- MY PROGRAMS ----
---------------------

local terminal    = "kitty"
local fileManager = "dolphin"
local menu        = "wofi --show drun"
local browser     = "zen-browser"

-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("GSK_RENDERER=gl ironbar & blueman-applet")
    -- hl.exec_cmd("copyq")
    -- hl.exec_cmd("openrgb --startminimized")
    hl.exec_cmd("/usr/lib/polkit-kde-authentication-agent-1")
    hl.exec_cmd("pactl load-module module-switch-on-connect")
    hl.exec_cmd("hyprsunset")
    hl.exec_cmd("hypridle")
    -- hl.exec_cmd("audiorelay --minimized")
    -- Desktop/VR host-specific autostarts moved to local profile.
end)

-------------------------------
---- ENVIRONMENT VARIABLES ----
-------------------------------

-- Qt6 style/colors/icons via qt6ct (non-Plasma session)
hl.env("QT_QPA_PLATFORMTHEME", "qt6ct")

hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")
-- GPU driver hints, picked at config-parse time.
-- The dGPU is removable on this box; when it is out, forcing the nvidia backends
-- does not stop the session from starting, it just breaks GLX apps and VA-API
-- decode in confusing ways. The probe is fully guarded: any failure falls through
-- to the iGPU branch, which is the safe configuration.
local function have_nvidia()
    if type(io) ~= "table" or type(io.open) ~= "function" then return false end
    local ok, f = pcall(io.open, "/proc/driver/nvidia/version", "r")
    if not ok or not f then return false end
    f:close()
    return true
end

if have_nvidia() then
    hl.env("LIBVA_DRIVER_NAME", "nvidia")
    hl.env("__GLX_VENDOR_LIBRARY_NAME", "nvidia")
    hl.env("NVD_BACKEND", "direct")
else
    -- Raphael iGPU: let libglvnd pick the GLX vendor on its own.
    hl.env("LIBVA_DRIVER_NAME", "radeonsi")
end

----------------------------
---- RENDER / MISC ----
----------------------------

hl.config({
    render = {
        cm_enabled = true,
    },

    -- Session lock normally hides all desktop content (Wayland security model). Without this,
    -- transparent areas in hyprlock blend against black — not your wallpaper. Enabling xray
    -- composites the live session behind the lock layer (weaker visual privacy if you use transparency).
    misc = {
        session_lock_xray = true,
        focus_on_activate = true,
    },
})

-----------------------
---- LOOK AND FEEL ----
-----------------------

hl.config({
    general = {
        gaps_in  = 5,
        gaps_out = { top = 0, right = 5, bottom = 5, left = 5 },

        border_size = 2,

        col = {
            active_border   = { colors = { "rgb(89B4FA)", "rgb(f5c2e7)" }, angle = 45 },
            inactive_border = "rgba(595959aa)",
        },

        resize_on_border = true,
        allow_tearing    = false,

        layout = "dwindle",
    },

    -- https://wiki.hypr.land/Configuring/Basics/Variables/#decoration
    decoration = {
        rounding       = 10,
        rounding_power = 2,

        -- Change transparency of focused and unfocused windows
        active_opacity   = 1.0,
        inactive_opacity = 1.0,

        shadow = {
            enabled      = true,
            range        = 4,
            render_power = 3,
            color        = "rgba(1a1a1aee)",
        },

        blur = {
            enabled  = true,
            size     = 10,
            passes   = 4,
            vibrancy = 0,
        },
    },

    dwindle = {
        preserve_split        = true,
        use_active_for_splits = true,
        force_split           = 2,
        smart_resizing        = false,
    },

    master = {
        new_status = "master",
    },
})

hl.layer_rule({ match = { namespace = "^ironbar$" }, blur = true })
-- hl.layer_rule({ match = { namespace = "^ironbar$" }, ignore_alpha = 0.5 })

--------------------
---- ANIMATIONS ----
--------------------

hl.curve("easeOutQuint",   { type = "bezier", points = { {0.23, 1},    {0.32, 1} } })
hl.curve("easeInOutCubic", { type = "bezier", points = { {0.65, 0.05}, {0.36, 1} } })
hl.curve("linear",         { type = "bezier", points = { {0, 0},       {1, 1}    } })
hl.curve("almostLinear",   { type = "bezier", points = { {0.5, 0.5},   {0.75, 1} } })
hl.curve("quick",          { type = "bezier", points = { {0.15, 0},    {0.1, 1}  } })

hl.animation({ leaf = "global",        enabled = true,  speed = 10,   bezier = "default" })
hl.animation({ leaf = "border",        enabled = true,  speed = 5.39, bezier = "easeOutQuint" })
hl.animation({ leaf = "windows",       enabled = true,  speed = 4.79, bezier = "easeOutQuint" })
hl.animation({ leaf = "windowsIn",     enabled = false, speed = 4.1,  bezier = "easeOutQuint", style = "popin 87%" })
hl.animation({ leaf = "windowsOut",    enabled = true,  speed = 1.49, bezier = "linear",       style = "popin 87%" })
hl.animation({ leaf = "fadeIn",        enabled = true,  speed = 1.73, bezier = "almostLinear" })
hl.animation({ leaf = "fadeOut",       enabled = true,  speed = 1.46, bezier = "almostLinear" })
hl.animation({ leaf = "fade",          enabled = true,  speed = 3.03, bezier = "quick" })
hl.animation({ leaf = "layers",        enabled = true,  speed = 3.81, bezier = "easeOutQuint" })
hl.animation({ leaf = "layersIn",      enabled = true,  speed = 1.5,  bezier = "quick",        style = "fade" })
hl.animation({ leaf = "layersOut",     enabled = true,  speed = 1.5,  bezier = "linear",       style = "fade" })
hl.animation({ leaf = "fadeLayersIn",  enabled = true,  speed = 1.79, bezier = "almostLinear" })
hl.animation({ leaf = "fadeLayersOut", enabled = true,  speed = 1.39, bezier = "almostLinear" })
hl.animation({ leaf = "workspaces",    enabled = true,  speed = 1.94, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "workspacesIn",  enabled = true,  speed = 1.21, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "workspacesOut", enabled = true,  speed = 1.94, bezier = "almostLinear", style = "fade" })

---------------
---- INPUT ----
---------------

-- https://wiki.hypr.land/Configuring/Basics/Variables/#input
hl.config({
    input = {
        follow_mouse                = 0,
        mouse_refocus               = false,
        float_switch_override_focus = 0,

        sensitivity = 0, -- -1.0 - 1.0, 0 means no modification.

        -- US + Canadian French as one XKB group list. Lock script forces US before hyprlock, then
        -- restores this group's active index after unlock. Super+comma toggles via script; Alt+Shift cycles.
        kb_layout  = "us,ca",
        kb_variant = ",fr",
        kb_options = "grp:alt_shift_toggle",
    },

    cursor = {
        no_hardware_cursors = 0,
    },
})

---------------------
---- KEYBINDINGS ----
---------------------

-- See https://wiki.hypr.land/Configuring/Basics/Binds/
local mainMod = "SUPER" -- Sets "Windows" key as main modifier

hl.bind(mainMod .. " + Return",         hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + SHIFT + Return", hl.dsp.exec_cmd(terminal, { float = true, size = { 1800, 1000 }, center = true }))
hl.bind(mainMod .. " + g",              hl.dsp.exec_cmd(browser))
hl.bind(mainMod .. " + SHIFT + g",      hl.dsp.exec_cmd(browser, { float = true, center = true }))
hl.bind("CTRL + SHIFT + c",             hl.dsp.exec_cmd("copyq show"))
hl.bind(mainMod .. " + R",              hl.dsp.exec_cmd("kitty -e ranger"))
hl.bind(mainMod .. " + SHIFT + R",      hl.dsp.exec_cmd("kitty -e ranger", { float = true, center = true }))
hl.bind(mainMod .. " + Z",              hl.dsp.exec_cmd("zathura"))
hl.bind(mainMod .. " + SHIFT + Z",      hl.dsp.exec_cmd("zathura", { float = true, center = true }))

hl.bind(mainMod .. " + W",                hl.dsp.window.close())
hl.bind(mainMod .. " + SHIFT + W",        hl.dsp.window.kill())
hl.bind(mainMod .. " + SHIFT + CTRL + Q", hl.dsp.exit())
hl.bind(mainMod .. " + E",                hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + SHIFT + E",        hl.dsp.exec_cmd(fileManager, { float = true, center = true }))
hl.bind(mainMod .. " + F",                hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + C",                hl.dsp.window.center())
hl.bind(mainMod .. " + CTRL + F",         hl.dsp.exec_cmd("~/.config/scripts/float_next"))
hl.bind(mainMod .. " + Space",            hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + P",                hl.dsp.window.pseudo()) -- dwindle
hl.bind(mainMod .. " + T",                hl.dsp.layout("togglesplit"))
hl.bind(mainMod .. " + M",                hl.dsp.window.fullscreen({ mode = "maximized" }))
hl.bind(mainMod .. " + SHIFT + F",        hl.dsp.window.fullscreen({ mode = "fullscreen" }))
hl.bind(mainMod .. " + Q",                hl.dsp.window.pin())

hl.bind("Print",         hl.dsp.exec_cmd("hyprshot -m region"))
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("hyprshot -m output -z"))

-- Screen lock ($mainMod+l is movefocus right; use Shift+L)
-- Empty workspace first so hyprlock's screenshot background shows wallpaper, not stacked windows.
hl.bind(mainMod .. " + SHIFT + L", hl.dsp.exec_cmd("~/.config/scripts/hyprlock_empty_then_restore.sh"))

-- Move focus with mainMod + vim
hl.bind(mainMod .. " + h", hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + l", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + k", hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + j", hl.dsp.focus({ direction = "down" }))

-- Cycle through windows on current workspace (Alt+Tab style)
hl.bind("ALT + Tab",         hl.dsp.window.cycle_next())
hl.bind("ALT + SHIFT + Tab", hl.dsp.window.cycle_next({ next = false })) -- previous

-- swap window with window in specified direction
hl.bind(mainMod .. " + SHIFT + h", hl.dsp.window.swap({ direction = "left" }))
hl.bind(mainMod .. " + SHIFT + l", hl.dsp.window.swap({ direction = "right" }))
hl.bind(mainMod .. " + SHIFT + k", hl.dsp.window.swap({ direction = "up" }))
hl.bind(mainMod .. " + SHIFT + j", hl.dsp.window.swap({ direction = "down" }))

-- preselect
hl.bind(mainMod .. " + CTRL + h", hl.dsp.exec_cmd("/home/amda/.config/scripts/preselect_overlay l"))
hl.bind(mainMod .. " + CTRL + l", hl.dsp.exec_cmd("/home/amda/.config/scripts/preselect_overlay r"))
hl.bind(mainMod .. " + CTRL + k", hl.dsp.exec_cmd("/home/amda/.config/scripts/preselect_overlay u"))
hl.bind(mainMod .. " + CTRL + j", hl.dsp.exec_cmd("/home/amda/.config/scripts/preselect_overlay d"))
hl.bind(mainMod .. " + O",        hl.dsp.exec_cmd("/home/amda/.config/scripts/move_to_preselect"))

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    hl.bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

-- Special workspace (scratchpad)
hl.bind(mainMod .. " + S",         hl.dsp.workspace.toggle_special("magic"))
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }))

-- Scroll through existing workspaces with mainMod + scroll
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize windows with mainMod + LMB/RMB and dragging
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Laptop multimedia keys for volume and LCD brightness
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   { locked = true, repeating = true })
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })

-- Requires playerctl
hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })

-- Keyboard layout
hl.bind(mainMod .. " + comma", hl.dsp.exec_cmd("~/.config/scripts/toggle_kb_layout.sh"))

-- AudioRelay (toggle its hidden workspace)
hl.bind(mainMod .. " + A", hl.dsp.workspace.toggle_special("audiorelay"))

-- WiVRn!!
hl.bind(mainMod .. " + grave", hl.dsp.exec_cmd("~/.config/scripts/wivern_connect.sh"))

-- Voice dictation toggle
-- hl.bind(mainMod .. " + D", hl.dsp.exec_cmd("~/.config/scripts/dictation/dictation-toggle.sh"))
hl.bind(mainMod .. " + D", hl.dsp.exec_cmd("~/.config/scripts/dictation/dictation-rt-toggle.sh"))

--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

-- See https://wiki.hypr.land/Configuring/Basics/Window-Rules/
-- and https://wiki.hypr.land/Configuring/Basics/Workspace-Rules/
hl.window_rule({ match = { class = "copy." },                  float = true })
hl.window_rule({ match = { class = "com.github.hluk.copyq" },  float = true, size = { 500, 600 } })
hl.window_rule({ match = { class = "blueman-manager" },        float = true })
-- hl.window_rule({ match = { class = "^(com-azefsw-audioconnect-desktop-app-MainKt)$" }, workspace = "special:audiorelay silent" })
hl.window_rule({ match = { class = "discord" },                float = true })
hl.window_rule({ match = { class = "Spotify" },                float = true })
-- hl.window_rule({ match = { class = "^(Cursor|cursor)$" }, opacity = "0.9 0.9" })

hl.window_rule({ match = { fullscreen_state_internal = 1 }, border_size = 0 })
hl.window_rule({ match = { pin = true }, border_color = "rgb(89B4FA) rgb(89B4FA)", border_size = 3 })

-- Ignore maximize requests from apps. You'll probably like this.
hl.window_rule({ match = { class = ".*" }, suppress_event = "maximize" })

-- Fix some dragging issues with XWayland
hl.window_rule({
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },
    no_focus = true,
})
